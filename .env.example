# MV Cliente IA · TODA la configuración del producto, en un solo lugar
# ============================================================================
#
# Este archivo NO lleva ningún valor real: sólo los NOMBRES de las variables,
# de dónde sale el valor de cada una y qué pasa exactamente si falta. Es el
# espejo en código del manual de puesta en producción.
#
# Cómo se usa
# -----------
#   · En Vercel (la web pública):  Project → Settings → Environment Variables,
#     alcance "Production". Después de cargarlas hay que REDESPLEGAR.
#   · En local o en un servidor propio: copiá este archivo a `.env` y completá
#     los valores. `.env` y `.env.*` están en .gitignore — NUNCA se commitean.
#
# Regla que no se rompe: ningún valor real entra a este repositorio. El
# repositorio es PÚBLICO; una clave commiteada queda en el historial de git
# para siempre, aunque después se borre del archivo.
#
# El orden de abajo es el de la puesta en marcha: primero lo que hace que
# COBRES, después lo que hace que ENTREGUES, y al final lo opcional.
# `tests/test_configuracion.py` falla si el código lee una variable que este
# archivo no documenta, así que la lista no se puede desincronizar.


# ============================================================================
# 1. COBRAR — sin esto el botón «Comprar» no cobra
# ============================================================================

# MercadoPago → Credenciales de producción → Access Token.
# Si falta: /api/checkout responde 503 y le dice al visitante que escriba.
MERCADOPAGO_ACCESS_TOKEN=

# Clave secreta del webhook de MercadoPago (Tus integraciones →
# Webhooks/Notificaciones → "Clave secreta"). Sirve para comprobar que la
# notificación de pago la mandó MercadoPago y no cualquiera.
# Si falta: el webhook RECHAZA todo (401). Es a propósito: sin firma no hay
# forma de distinguir un aviso real de uno inventado, y este endpoint emite
# licencias. El cliente igual recibe su clave al volver del pago.
MERCADOPAGO_WEBHOOK_SECRET=

# Precio de la licencia. Si faltan, se usan los del código (US$ 149 / $U 6000).
MVCLIENTE_PRECIO_USD=
MVCLIENTE_PRECIO_UYU=


# ============================================================================
# 2. ENTREGAR LA LICENCIA — sin esto cobrás y el cliente no recibe nada
# ============================================================================

# El secreto con el que se FIRMAN y se VALIDAN las claves de licencia.
# Generarlo:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Vive en dos lugares: el servidor (para validar y emitir al cobrar) y tu
# máquina (para emitir a mano). NUNCA dentro de un instalador.
# ⚠ Si lo perdés o lo cambiás, las claves ya emitidas dejan de validar.
# Si falta: cae a MVCLIENTE_OWNER; si tampoco está, no se pueden emitir ni
# validar licencias y /api/pago/licencia responde 503.
MVCLIENTE_LICENCIA_SECRETO=

# Meses que dura la licencia que se emite al pagar. Si falta: 12.
MVCLIENTE_MESES_LICENCIA=

# Casilla desde la que salen los correos DEL SERVIDOR: la licencia al
# comprador, el aviso de pedido de demo y el aviso de intento de compra.
# Con Gmail hace falta una contraseña de aplicación
# (myaccount.google.com/apppasswords), no la contraseña normal.
# Si faltan: el webhook no puede mandarle la licencia al comprador (queda
# igual en el log del servidor), el formulario de demo responde enviado:false
# y muestra tu correo directo, y no llega el aviso de click en «Comprar».
MVCLIENTE_SMTP_HOST=
MVCLIENTE_SMTP_PUERTO=
MVCLIENTE_SMTP_USUARIO=
MVCLIENTE_SMTP_CLAVE=
MVCLIENTE_SMTP_SSL=

# A qué dirección llegan los avisos del dueño (pedidos de demo, intentos de
# compra). Si falta: vieraschiavi@gmail.com.
MVCLIENTE_OWNER_EMAIL=

# Dónde valida la licencia el programa YA INSTALADO (PC/BAT/APK).
# Si falta: https://mv-cliente-ia.vercel.app
MVCLIENTE_URL_LICENCIAS=


# ============================================================================
# 3. EL DUEÑO Y EL CUPO GRATIS
# ============================================================================

# Tu código de dueño: te exime del cupo gratis de la web y abre el panel del
# dueño. El mismo valor se pega en la app (Configuración → Código de dueño).
# Generarlo:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Si falta: no hay forma de quedar exento del cupo ni de abrir el panel.
MVCLIENTE_OWNER=

# Búsquedas reales gratis por visitante antes de pedir la compra.
# Si falta: 3.
MVCLIENTE_CUPO_GRATIS=

# Contraseña de la instancia. Si está, la API entera exige login.
# Se usa para un despliegue privado; la web pública va SIN esto.
# Ojo: también entra en el secreto de la cookie de cupo — sin ella NI
# MVCLIENTE_OWNER, esa cookie se firma con una constante pública.
MVCLIENTE_PASSWORD=

# Edición de ESTA copia: demo | cliente | owner. Se hornea al construir
# (`edicion.json` al lado del motor) y el sello horneado siempre gana.
# Sin sello ni variable: demo, que es el default seguro.
MVCLIENTE_EDICION=


# ============================================================================
# 4. MEDIR — aperturas, clicks, visitas y respuestas
# ============================================================================

# Las DOS encienden la medición. Sin ellas el correo sale sin pixel y los
# enlaces salen directos: es una función que se prende a propósito, no un
# rastreador por default. El panel avisa cuando están apagadas para que un 0%
# no se lea como un fracaso comercial.
# Generar el secreto: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MVCLIENTE_TRAQUEO_SECRETO=
MVCLIENTE_URL_TRAQUEO=

# Dónde persisten las métricas cuando el backend corre SIN DISCO (Vercel).
# Vercel → Storage → Create Database → KV, y conectarlo al proyecto: las
# inyecta solas. Un store de Upstash creado a mano también sirve (las dos
# parejas de nombres se aceptan).
# Si faltan: se usa el archivo local, y en serverless eso se borra entre
# invocaciones — el panel del dueño lo avisa con todas las letras.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Minutos de silencio entre dos avisos de «alguien apretó Comprar», para que
# un indeciso que clickea cinco veces no llene la casilla. En SEGUNDOS.
# Si falta: 1800 (30 minutos).
MVCLIENTE_AVISO_COMPRA_SILENCIO_S=

# Techo del archivo de métricas, en bytes. Si falta: 20 MB.
MVCLIENTE_METRICAS_MAX_BYTES=

# Ajustes finos del store KV. Si faltan: 50000 eventos, TTL de 90 días para
# los nonces, 3 segundos de timeout.
MVCLIENTE_KV_MAX_EVENTOS=
MVCLIENTE_KV_TTL_NONCE=
MVCLIENTE_KV_TIMEOUT=


# ============================================================================
# 5. IA — opcional: cada visitante normalmente pone SU propia clave
# ============================================================================

# Sólo si querés ofrecer investigación con IA sin que el visitante ponga su
# clave. Corre por tu cuenta: el consumo lo pagás vos.
# Si falta: cada visitante usa su propia clave, que el servidor usa y
# descarta. Es el modo normal.
ANTHROPIC_API_KEY=

# Modelo por proveedor. Si faltan, se usan los defaults del código.
MVCLIENTE_MODELO=
MVCLIENTE_MODELO_OPENAI=
MVCLIENTE_MODELO_GEMINI=
MVCLIENTE_MODELO_COPILOT=
MVCLIENTE_MODELO_GROK=

# Segundos de espera máxima a una respuesta de IA. Si falta: 180.
MVCLIENTE_TIMEOUT_IA=

# Segundos de presupuesto de IA cuando corre en serverless, para no chocar
# contra el límite de la función. Si falta: 240.
MVCLIENTE_PRESUPUESTO_IA=

# Poné 0 para apagar la verificación de segmento (que sale a leer los sitios
# de los candidatos). Si falta: encendida, que es lo correcto.
MVCLIENTE_VERIFICAR_SEGMENTO=


# ============================================================================
# 6. VARIOS
# ============================================================================

# Enlace de tu agenda (Calendly, Google Calendar) para el formulario de demo.
# Si falta: no se ofrece agendar, que es lo correcto — no se promete un
# recurso que no existe.
MVCLIENTE_URL_AGENDA=

# Repositorio del que la app ofrece las descargas. Si falta:
# vieraschiavi/MV-Cliente-IA
MVCLIENTE_REPO=

# Dónde guarda sus datos el programa instalado. Si falta: la carpeta de datos
# del usuario que corresponda al sistema operativo.
MVCLIENTE_DIR_DATOS=

# Poné 1 para forzar el modo sin disco (el que usa la web serverless).
# En Vercel se detecta solo; esto es para probarlo en local.
MVCLIENTE_SIN_ESTADO=

# Puerto del lanzador de escritorio. Si falta: 8810, y si está ocupado busca
# uno libre.
MVCLIENTE_PUERTO=
